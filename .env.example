# LLM provider: deepseek（默认） | moonshotai-cn（Kimi 国内站） | longcat（OpenAI 兼容，https://longcat.chat/platform/docs/zh/）
PROVIDER=deepseek

# 自定义单模型（配置 CUSTOM_MODEL_URL / CUSTOM_MODEL_PROTOCOL / CUSTOM_MODEL_ID 后自动优先使用）
# 协议可选：openai-completions | openai-responses | anthropic-messages
# CUSTOM_MODEL_URL=https://api.example.com/v1
# CUSTOM_MODEL_PROTOCOL=openai-completions
# CUSTOM_MODEL_ID=your-model-id
# CUSTOM_MODEL_PROVIDER_ID=custom
# CUSTOM_MODEL_API_KEY=

# DeepSeek API key（首选测试 provider）
DEEPSEEK_API_KEY=sk-...

# Moonshot (api.moonshot.cn) API key，PROVIDER=moonshotai-cn 时使用
MOONSHOT_API_KEY=sk-...

# LongCat (https://api.longcat.chat/openai) API key，PROVIDER=longcat 时使用
# 文档: https://longcat.chat/platform/docs/zh/ ，key 在 https://longcat.chat/platform/api_keys 创建
LONGCAT_API_KEY=sk-...

# Ollama 本地服务（PROVIDER=ollama 时使用，兼容 OpenAI 端点的聊天补全）
# 服务基址：Ollama 默认 http://localhost:11434 ，也可经 OLLAMA_HOST 远程部署
OLLAMA_BASE_URL=http://localhost:11434
# 默认模型（需先 `ollama pull`，如 llama3.2 / qwen2.5 / gemma2）
OLLAMA_DEFAULT_MODEL=llama3.2
# 本地服务通常无需 key；若反向代理带了鉴权可在此配置
OLLAMA_API_KEY=

# 模型 ID，具体可用值以 npm run list-models 输出为准
# deepseek: deepseek-v4-pro / deepseek-v4-flash
# moonshotai-cn: kimi-k2-0905-preview / kimi-k2.7-code ...
# longcat: LongCat-2.0
MODEL_ID=deepseek-v4-flash
# 推理级别（可选）: off | minimal | low | medium | high | max
THINKING_LEVEL=off

# 代码执行服务地址（本地 mock 默认 1313 端口）
EXEC_API_BASE=http://localhost:1313

# PostgreSQL 会话持久化（由宿主创建 pg.Pool 后注入 PostgresSessionStore）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=pilore
DB_PASSWORD=change-me
DB_NAME=pilore

# Web 界面会话快照加密 key：64 位 hex（32 字节），如 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 配置 DB_* 但缺少本项时，npm run web 回退内存持久化（重启丢失）
SESSION_ENCRYPTION_KEY=

# Web 内测邀请码登录（真实模式强制启用；FAUX_DEMO=1 免登录）
# Cookie HMAC 密钥（≥32 字符）：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未设置时随机生成，进程重启后所有用户需重新登录
AUTH_SECRET=
# 用户注册表路径（默认 data/beta-users.json；用 npm run gen:beta-codes 生成）
# BETA_USERS_FILE=data/beta-users.json
# HTTPS 反代部署时设 1 强制 Cookie Secure 标记（默认按 x-forwarded-proto/TLS 自动判断）
# WEB_COOKIE_SECURE=1
# 模型可用的总上下文窗口（包含 system prompt、工具 schema、历史与本轮输入）；留空时使用模型声明值。
# 可用它为供应商部署的实际窗口设置更保守的上限。
# PILORE_CONTEXT_WINDOW=128000

# 单条用户消息的最大 token 预算；留空时按模型上下文窗口自动取安全默认值。
# PILORE_MAX_INPUT_TOKENS=12000
