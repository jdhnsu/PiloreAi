# LLM provider: deepseek（默认） | moonshotai-cn（Kimi 国内站） | longcat（OpenAI 兼容，https://longcat.chat/platform/docs/zh/）
PROVIDER=deepseek

# DeepSeek API key（首选测试 provider）
DEEPSEEK_API_KEY=sk-...

# Moonshot (api.moonshot.cn) API key，PROVIDER=moonshotai-cn 时使用
MOONSHOT_API_KEY=sk-...

# LongCat (https://api.longcat.chat/openai) API key，PROVIDER=longcat 时使用
# 文档: https://longcat.chat/platform/docs/zh/ ，key 在 https://longcat.chat/platform/api_keys 创建
LONGCAT_API_KEY=sk-...

# 模型 ID，具体可用值以 npm run list-models 输出为准
# deepseek: deepseek-v4-pro / deepseek-v4-flash
# moonshotai-cn: kimi-k2-0905-preview / kimi-k2.7-code ...
# longcat: LongCat-2.0
MODEL_ID=deepseek-v4-flash
# 推理级别（可选）: off | minimal | low | medium | high | max
THINKING_LEVEL=off

# 代码执行服务地址（本地 mock 默认 1313 端口）
EXEC_API_BASE=http://192.168.172.134:1313

# PostgreSQL 会话持久化（由宿主创建 pg.Pool 后注入 PostgresSessionStore）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=pilore
DB_PASSWORD=change-me
DB_NAME=pilore

# Web 界面会话快照加密 key：64 位 hex（32 字节），如 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 配置 DB_* 但缺少本项时，npm run web 回退内存持久化（重启丢失）
SESSION_ENCRYPTION_KEY=
