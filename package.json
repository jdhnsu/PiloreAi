{
  "name": "pilore-edu-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "description": "PiLore — 可扩展的多领域教学 Agent Core 与 Domain Packs",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "mock": "tsx mock/exec-server.ts",
    "chat": "tsx src/adapters/cli/index.ts",
    "chat:judge": "tsx src/adapters/cli/index.ts --pack judge",
    "chat:english": "tsx src/adapters/cli/index.ts --pack english",
    "chat:math": "tsx src/adapters/cli/index.ts --pack math",
    "chat:physics": "tsx src/adapters/cli/index.ts --pack physics",
    "chat:history": "tsx src/adapters/cli/index.ts --pack history",
    "chat:list": "tsx src/adapters/cli/index.ts --list",
    "web": "tsx src/adapters/web/index.ts",
    "web:demo": "tsx scripts/web-demo.ts",
    "demo": "tsx scripts/demo.ts",
    "list-models": "tsx scripts/list-models.ts",
    "gen:beta-codes": "tsx scripts/gen-beta-codes.ts",
    "cache:warmup": "tsx scripts/cache-warmup.ts",
    "cache:realistic": "tsx scripts/cache-realistic.ts",
    "example:embed": "tsx examples/embed-minimal.ts",
    "gen:module-graph": "tsx scripts/gen-module-graph.ts",
    "verify:module-graph": "tsx scripts/gen-module-graph.ts --check",
    "build:runtime": "npm run build --workspace=@pilore/pi-telemetry && npm run build:offline --workspace=@pilore/pi-ai && npm run build --workspace=@pilore/pi-agent-core",
    "verify:runtime-source": "node scripts/verify-runtime-source.mjs",
    "export:runtime-mirrors": "node scripts/export-runtime-mirrors.mjs",
    "test:runtime": "npm run build:runtime && npm run test:offline --workspace=@pilore/pi-telemetry && npm run test:offline --workspace=@pilore/pi-ai && npm run test:offline --workspace=@pilore/pi-agent-core",
    "pretypecheck": "npm run build:runtime",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:runtime",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:postgres": "node --import tsx --test tests/integration/postgres-store.test.ts",
    "test:agent": "node --import tsx --test tests/unit/core.test.ts tests/unit/code-pack.test.ts tests/unit/code-mentor-session.test.ts tests/unit/english-pack.test.ts tests/unit/academic-packs.test.ts",
    "test:agent:real": "tsx tests/run.ts --iterations 3",
    "test:router:real": "tsx tests/run-router-real.ts",
    "test:agent:all": "npm test && npm run test:agent:real"
  },
  "dependencies": {
    "@pilore/pi-agent-core": "0.84.1-pilore.0",
    "@pilore/pi-ai": "0.84.1-pilore.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.10",
    "shx": "0.4.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.9"
  }
}
